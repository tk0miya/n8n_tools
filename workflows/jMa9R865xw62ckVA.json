        320,
        128
      ],
      "notes": "Withings は callback の応答を待たないので、まず 200 を即返す"
    },
    {
      "parameters": {
        "jsCode": "const THRESHOLD = 60 * 1000;\nconst body = $input.first().json.body || {};\nconst data = $getWorkflowStaticData('global');\nconst userid = body.userid;\n\n// 60秒以内の再通知は無視する\nconst lastMeasuredAt = data[userid]?.lastMeasuredAt;\nif (lastMeasuredAt && Date.now() - lastMeasuredAt < THRESHOLD) {\n  return [];\n}\n\n\ndata[userid] = {\n  lastMeasuredAt: Date.now()\n}\n\nlet username = \"誰か\";\nif (body.userid == 5020765) {\n  username = \"たけし\"\n}\n\nreturn [{ json: { userid, username }}];"
      },
