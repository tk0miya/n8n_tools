        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const THRESHOLD = 7 * 24 * 60 * 60 * 1000;\n\nconst data = $getWorkflowStaticData('global');\nconst userid = 5020765;\n\nif (!data[userid]) {\n  return [];\n}\n\nconst lastMeasuredAt = data[userid].lastMeasuredAt;\n\nif (Date.now() - lastMeasuredAt > THRESHOLD) {\n  return [{ json: {} }]\n}\n\nreturn [];"
      },
